{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild:win": "if exist ..\\public\\uploads ( move ..\\public\\uploads ..\\uploads_temp )",
		"build:win": "npm run prebuild:win && vite build && npm run postbuild:win",
		"postbuild:win": "if exist ..\\uploads_temp ( move ..\\uploads_temp ..\\public\\uploads )",
		"prebuild:unix": "if [ -d ../public/uploads ]; then mv ../public/uploads ../uploads_temp; fi",
		"build:unix": "npm run prebuild:unix && vite build && npm run postbuild:unix",
		"postbuild:unix": "if [ -d ../uploads_temp ]; then mv ../uploads_temp ../public/uploads; fi",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.2"
	}
}
