RewriteEngine On
RewriteBase /

# Deshabilitar búsqueda automática de index
DirectoryIndex disabled

# Si alguien entra a /api sin barra, redirigir a /api/
RewriteRule ^api$ /api/ [R=301,L]

# SOLO rutas /api/ y /api/* van a api.php (API)
RewriteRule ^api/ api.php [L,QSA]

# Servir archivos estáticos directamente (CSS, JS, imágenes, etc)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*$ - [L]

# NO servir directorios directamente (comentado para forzar rewrite)
# RewriteCond %{REQUEST_FILENAME} -d
# RewriteRule ^.*$ - [L]

# IMPORTANTE: Todo lo demás va al SPA (History API routing)
# Esto incluye /, /peliculas, /perfil, etc.
RewriteRule ^.*$ public/index.html [L]
