<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- API ---
  # Route all /api/... requests to api.php
  RewriteRule ^api/.*$ api.php [L]

  # --- SvelteKit SPA ---

  # First, check if a file is being requested directly from the public folder.
  # This handles cases where the URL already contains /public/.
  RewriteCond %{REQUEST_URI} ^/public/
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If the request is for a file that exists in the actual /public/ directory
  # (e.g., /_app/...), then rewrite the request to be from that directory.
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /public/$1 [L]

  # If the request is not for an API route and not for an existing file,
  # rewrite it to the SPA's entry point in the public folder.
  # This allows SvelteKit's client-side router to handle the URL.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule .* /public/index.html [L]
</IfModule>